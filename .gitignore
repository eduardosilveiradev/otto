# Personality generated at install time — contains the user's personal data.
/CLAUDE.md

# Secrets and state. Never commit.
*.env
telegram.env
.env

# Runtime and logs
/runtime/*
!/runtime/.gitkeep
/logs/
node_modules/
bun.lockb

# Otto's state (bot token, allowlist, memory, history) lives here when the repo
# is cloned to ~/.otto. Never commit it — and never `git clean -fdx` this repo.
/state/
